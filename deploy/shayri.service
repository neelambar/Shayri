# systemd unit for the Shayri app. Install with:
#   sudo cp deploy/shayri.service /etc/systemd/system/ && sudo systemctl daemon-reload && sudo systemctl enable --now shayri
[Unit]
Description=Shayri - Hindi poem collection (gunicorn)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/Shayri
# systemd creates /var/lib/shayri (owned by User) for the SQLite database
StateDirectory=shayri
Environment=SHAYRI_DB=/var/lib/shayri/shayri.db
# Only listen on localhost; Caddy (with basic_auth) is the public entry point
ExecStart=/home/ubuntu/Shayri/.venv/bin/gunicorn --bind 127.0.0.1:8001 --workers 2 --threads 4 app:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
